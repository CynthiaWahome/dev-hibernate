# DevHibernate environment configuration
# Copy this file to .env and adjust as needed.

# Server port (default: 4317)
PORT=4317

# Database path (default: ./data/dev-hibernate.sqlite)
# DB_PATH=/path/to/dev-hibernate.sqlite

# Allowed CORS origin for the UI dev server
ALLOWED_ORIGIN=http://localhost:5173

# Ollama endpoint (default: http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434

# Ollama model to use for plan generation (default: gemma3:1b)
# OLLAMA_MODEL=gemma3:1b

# Plan expiry in minutes (default: 5)
# PLAN_EXPIRY_MINUTES=5